<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Profile builds only, for testing Majlis against the local emulators
         (WELLMATE_LOCAL_BACKEND, see MAJLIS.md): plain http to the emulators, and Firebase is started from Dart
         (main.dart) instead of automatically from google-services.json, so
         the local test project can be used. Release builds are unchanged. -->
    <application android:usesCleartextTraffic="true">
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>
</manifest>
